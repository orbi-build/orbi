<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- One launchd agent per Runner instance: the plist is the
         .service and the .timer in one. At max_concurrency == 1 the
         StartInterval below mirrors the systemd
         OnCalendar=*-*-* *:00/5 five-minute tick. At N > 1 the
         renderer drops StartInterval and switches every instance to
         the equivalent wall-clock StartCalendarInterval grid on the
         same five-minute cadence, each instance shifted by its own
         whole-minute offset `(instance - 1) * (300 // N) // 60`
         (`*:00/5` for instance 1; `*:02/5` for instance 2 at N = 2;
         `*:00/5`, `*:01/5`, `*:03/5` at N = 3 — Issue #1320):
         StartInterval counts from each job's load time, so instances
         bootstrapped together would otherwise fire in the same
         second. The ORBI_* placeholders are substituted at install
         time by `orbi install-units`; the drift check re-renders this
         template and compares the canonical plist form, so key order
         and whitespace in the installed XML never fabricate drift. -->
    <key>Label</key>
    <string>{{ORBI_LABEL}}</string>
    <key>WorkingDirectory</key>
    <string>{{ORBI_REPO_DIR}}</string>
    <key>ProgramArguments</key>
    <array>
      <string>/bin/sh</string>
      <string>-c</string>
      <!-- Mirrors the systemd EnvironmentFile=- contract: the
           optional env file carries the provider keys OUTSIDE the
           template. `set -a` exports the bare KEY=value assignments to
           the exec'd runner; the `[ -r` guard keeps a missing env file
           from aborting the non-interactive sh (the `-` optional
           semantics); `&&` is XML-escaped as &amp;&amp; in this file. -->
      <!-- Issue #871: the sync step mirrors the Linux ExecStartPre
           step 2 (systemd/orbi@.service): `sync-engine-source` brings
           the deployment checkout to the configured engine_source_track
           channel before the Runner starts, AFTER the env sourcing (the
           sync's git transport may need the env-file credentials) and
           chained with `&&` — a failed sync (the CLI exits 1) stops the
           chain, the exec never runs and the tick does not start (fail
           closed, the ExecStartPre failure semantics; the reason lands
           in StandardErrorPath). macOS ships neither /usr/bin/flock nor
           timeout, so the launchd shape is the plain Issue-pinned
           command. -->
      <string>[ -r '{{ORBI_REPO_DIR}}/.orbi/env' ] &amp;&amp; { set -a; . '{{ORBI_REPO_DIR}}/.orbi/env'; set +a; }; '{{ORBI_USER_HOME}}/.local/bin/orbi' sync-engine-source &amp;&amp; exec '{{ORBI_USER_HOME}}/.local/bin/orbi'</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
      <key>ORBI_CONFIG</key>
      <string>{{ORBI_REPO_DIR}}/orbi.toml</string>
      <key>PATH</key>
      <!-- /opt/homebrew/bin leads: the Apple Silicon Homebrew prefix
           carries gh, uv and the global npm pi (Issue #869); Intel's
           /usr/local/bin stays for x86_64 macs. -->
      <string>/opt/homebrew/bin:{{ORBI_USER_HOME}}/.npm-global/bin:{{ORBI_USER_HOME}}/.local/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
    <!-- Single instance only: the renderer removes this key at N > 1
         and writes StartCalendarInterval on the same 5-minute grid. -->
    <key>StartInterval</key>
    <integer>300</integer>
    <!-- Runner output lands per instance in the gitignored state dir
         (the journal_lines hook tails exactly this file). -->
    <key>StandardOutPath</key>
    <string>{{ORBI_REPO_DIR}}/.orbi/{{ORBI_LABEL}}.log</string>
    <key>StandardErrorPath</key>
    <string>{{ORBI_REPO_DIR}}/.orbi/{{ORBI_LABEL}}.log</string>
  </dict>
</plist>
