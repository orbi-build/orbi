__pycache__/
.pytest_cache/
# Test/coverage artifacts (Issue #235): local generated files from a
# normal test run must never reach the dirty-worktree gate. Ignore
# rules only affect untracked files — a tracked log stays tracked.
*.log
coverage.log
.coverage*
coverage.xml
htmlcov/
# Python packaging build artifacts (Issue #140: pyproject.toml builds)
build/
dist/
*.egg-info/
.orbi/
.pi-session/
# pi-loop plugin state (Issue #215): written into the task worktree cwd at
# session shutdown (.pi/loops.json); not part of the agent's commit
# boundary, so deliver_pr's dirty-worktree gate must never see it.
.pi/
.worktrees/
orbi.toml
# Per-run artifacts written into the task worktree (prompt.md steps 2
# and 5): never version-controlled, so a new worktree created from the
# frozen base never inherits the previous run's plan or test log.
plan.md
test.log
verify.md
# Common local development artifacts (Issue #235): none of these
# patterns can mask source, config, credentials or delivery files.
.mypy_cache/
.ruff_cache/
.hypothesis/
.venv/
*.py[cod]
.DS_Store
*.swp
*.tmp
